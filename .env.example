# ==========================================
# CodeMind-AI Environment Configuration Example
# Kopyalayıp '.env' olarak kaydedebilirsiniz.
# ==========================================

# PostgreSQL Ayarları
POSTGRES_USER=codemind
POSTGRES_PASSWORD=codemindpassword
POSTGRES_DB=codemind_db
POSTGRES_PORT=5433

# PgAdmin Ayarları
PGADMIN_DEFAULT_EMAIL=admin@codemind.ai
PGADMIN_DEFAULT_PASSWORD=adminpassword

# MinIO Object Storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET_NAME=codemind-uploads

# Kafka & Event Bus
KAFKA_BROKER=localhost:9094
KAFKA_TOPIC=file-uploads
KAFKA_GROUP_ID=ai-worker-group

# JWT Authentication
JWT_SECRET=
WORKER_SECRET=
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3050
JWT_ISSUER=CodeMindApi
JWT_AUDIENCE=CodeMindClients

# AI & LLM Model Ayarları (Yerel Ollama veya Bulut)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DOCKER_URL=http://host.docker.internal:11434
OLLAMA_LLM_MODEL=llama3
OPENAI_MODEL=gpt-6.1-sol
ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_MODEL=gemini-3.8-flash
GROQ_MODEL=llama-3.3-70b-versatile

# Bulut model anahtarları kullanıcı tarafından arayüzden girilir.

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:5083
PORT=3000
