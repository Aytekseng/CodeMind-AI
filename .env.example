# ==========================================
# CodeMind-AI Environment Configuration Example
# Kopyalayıp '.env' olarak kaydedebilirsiniz.
# ==========================================

# PostgreSQL Ayarları
POSTGRES_USER=codemind
POSTGRES_PASSWORD=codemindpassword
POSTGRES_DB=codemind_db
POSTGRES_PORT=5433

# PgAdmin Ayarları
PGADMIN_DEFAULT_EMAIL=admin@codemind.ai
PGADMIN_DEFAULT_PASSWORD=adminpassword

# MinIO Object Storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET_NAME=codemind-uploads

# Kafka & Event Bus
KAFKA_BROKER=localhost:9092
KAFKA_TOPIC=file-uploads
KAFKA_GROUP_ID=ai-worker-group

# JWT Authentication
JWT_SECRET=CodeMind_Super_Secret_Key_For_JWT_Auth_2026!+
JWT_ISSUER=CodeMindApi
JWT_AUDIENCE=CodeMindClients

# AI & LLM Model Ayarları (Yerel Ollama veya Bulut)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# İsteğe Bağlı Cloud LLM Anahtarları (Kullanıcı kendi anahtarlarını girebilir)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:5083
PORT=3000
